[
  {
    "name": "design-doc-example",
    "note": "The document from the design doc.",
    "document": {
      "schema": "faro.sampling.rules/v1",
      "rules": [
        {
          "id": "no-bots",
          "scope": {
            "browser.userAgent": "*HeadlessChrome*"
          },
          "action": "drop"
        },
        {
          "id": "default-base",
          "action": "keep_session_and_replay",
          "baseRate": 0.05,
          "replayRate": 0.5
        },
        {
          "id": "errors",
          "trigger": {
            "type": "error"
          },
          "action": "keep_session_and_replay"
        },
        {
          "id": "checkout-step",
          "trigger": {
            "type": "page_view",
            "match": {
              "view": "checkout/*"
            }
          },
          "scope": {
            "session.attributes.FI": "acme"
          },
          "action": "keep_session"
        },
        {
          "id": "checkout-failed",
          "trigger": {
            "type": "custom_event",
            "match": {
              "name": "checkout_failed"
            }
          },
          "action": "keep_session_and_replay",
          "triggerRate": 0.5
        }
      ]
    },
