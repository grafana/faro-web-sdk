{
  "name": "@grafana/faro-transport-otlp-http",
  "packageManager": "yarn@4.18.0",
  "version": "2.11.0",
  "description": "Faro transport which converts the Faro data model to the Otlp data model.",
  "keywords": [
    "observability",
    "apm",
    "rum",
    "logs",
    "traces",
    "metrics",
    "otlp"
  ],
  "license": "Apache-2.0",
  "author": "Grafana Labs",
  "homepage": "https://github.com/grafana/faro-web-sdk",
  "repository": {
    "type": "git",
    "url": "https://github.com/grafana/faro-web-sdk.git",
    "directory": "experimental/transport-otlp-http"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    ".browserslistrc",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "yarn watch",
    "build": "tsdown",
    "watch": "tsdown --watch",
    "clean": "rimraf dist/ yarn-error.log",
    "quality": "run-s 'quality:*'",
    "quality:typecheck": "tsc -p tsconfig.typecheck.json",
    "quality:test": "jest",
    "quality:format": "prettier --cache --cache-location=../../.cache/prettier/transportOtlpHttp --ignore-path ../../.prettierignore -w \"./**/*.{js,jsx,ts,tsx,css,scss,md,yaml,yml,json}\"",
    "quality:lint": "run-s quality:lint:eslint quality:lint:prettier quality:lint:md",
    "quality:lint:eslint": "eslint --cache --cache-location ../../.cache/eslint/transportOtlpHttp \"./**/*.{js,jsx,ts,tsx}\"",
    "quality:lint:prettier": "prettier --cache --cache-location=../../.cache/prettier/transportOtlpHttp --ignore-path ../../.prettierignore -c \"./**/*.{js,jsx,ts,tsx,css,scss,md,yaml,yml,json}\"",
    "quality:lint:md": "markdownlint README.md",
    "quality:lint:fix": "run-s 'quality:lint:fix:*'",
    "quality:lint:fix:eslint": "eslint --fix --cache --cache-location ../../.cache/eslint/transportOtlpHttp \"./**/*.{js,jsx,ts,tsx}\"",
    "quality:lint:fix:prettier": "prettier --cache --cache-location=../../.cache/prettier/transportOtlpHttp --ignore-path ../../.prettierignore -w \"./**/*.{js,jsx,ts,tsx,css,scss,md,yaml,yml,json}\"",
    "quality:circular-deps": "madge --circular ."
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@grafana/faro-core": "^2.11.0",
    "@opentelemetry/otlp-transformer": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.28.0"
  }
}
